# the g2g source arrives as the `g2g` build context, a git archive of the checkout
ARG FEDORA_RELEASE=43
# the feeder unit runs this image, so the clips built here match the ones it loops
ARG MEDIAMTX_IMAGE=docker.io/bluenviron/mediamtx:1.21.2-ffmpeg
ARG LIVESIM2_VERSION=v1.14.0

FROM ${MEDIAMTX_IMAGE} AS mediamtx
COPY deploy/canary/feeder.sh /feeder.sh
RUN sh /feeder.sh clips /clips

FROM docker.io/library/golang:1.25-alpine AS livesim2
ARG LIVESIM2_VERSION
RUN apk add --no-cache git \
    && git clone --depth 1 --branch "${LIVESIM2_VERSION}" https://github.com/Dash-Industry-Forum/livesim2 /src \
    && cd /src && CGO_ENABLED=0 go build -o /livesim2 ./cmd/livesim2

FROM registry.fedoraproject.org/fedora:${FEDORA_RELEASE} AS base
# fedora's ffmpeg-free decodes h264 only through openh264, rpm fusion ships the native decoder
RUN dnf -y install "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
    && dnf clean all

# no fedora package carries nginx's rtmp module, so it is built against fedora's nginx as a dynamic module
FROM base AS nginx-rtmp
ARG NGINX_RTMP_VERSION=1.2.2
ARG NGINX_RTMP_SHA256=07f19b7bffec5e357bb8820c63e5281debd45f5a2e6d46b1636d9202c3e09d78
RUN dnf -y install nginx-mod-devel gcc make && dnf clean all
RUN curl -fsSLo /nginx-rtmp.tar.gz \
        "https://github.com/arut/nginx-rtmp-module/archive/refs/tags/v${NGINX_RTMP_VERSION}.tar.gz" \
    && echo "${NGINX_RTMP_SHA256}  /nginx-rtmp.tar.gz" | sha256sum -c - \
    && mkdir /nginx-rtmp && tar -xzf /nginx-rtmp.tar.gz -C /nginx-rtmp --strip-components 1 \
    && cp -a /usr/src/nginx-*/ /nginx-src && cd /nginx-src \
    && ./configure --with-compat --add-dynamic-module=/nginx-rtmp && make modules

# fedora's janus follows its updates repo, so the videoroom plugin and websocket transport build from a pinned release
FROM base AS janus
ARG JANUS_VERSION=1.4.3
ARG JANUS_SHA256=e66d752dcf0966cbb4f4c7d3264d6e295aeab21537594bd5e630e94a3640a9e5
RUN dnf -y install autoconf automake libtool make gcc pkgconf-pkg-config glib2-devel jansson-devel libconfig-devel \
        libnice-devel libsrtp-devel openssl-devel libwebsockets-devel zlib-devel \
    && dnf clean all
RUN curl -fsSLo /janus.tar.gz \
        "https://github.com/meetecho/janus-gateway/archive/refs/tags/v${JANUS_VERSION}.tar.gz" \
    && echo "${JANUS_SHA256}  /janus.tar.gz" | sha256sum -c - \
    && mkdir /janus && tar -xzf /janus.tar.gz -C /janus --strip-components 1 && cd /janus \
    && sh autogen.sh \
    && ./configure --prefix=/opt/janus --disable-docs --disable-data-channels --disable-turn-rest-api \
        --disable-all-plugins --enable-plugin-videoroom --disable-all-transports --enable-websockets \
        --disable-all-handlers --disable-all-loggers \
    && make -j"$(nproc)" && make install

FROM base AS livekit
ARG LIVEKIT_VERSION=1.13.11
ARG LIVEKIT_SHA256=1e9ee90ca301e1842b2887fc77cb122759756a9c8aeb4334ee91de3325ec43fb
RUN curl -fsSLo /livekit.tar.gz \
        "https://github.com/livekit/livekit/releases/download/v${LIVEKIT_VERSION}/livekit_${LIVEKIT_VERSION}_linux_amd64.tar.gz" \
    && echo "${LIVEKIT_SHA256}  /livekit.tar.gz" | sha256sum -c - \
    && tar -xzf /livekit.tar.gz -C / livekit-server

FROM base AS build
RUN dnf -y install --allowerasing cargo rust clang-devel pkgconf-pkg-config openssl-devel ffmpeg-devel \
        opus-devel libdav1d-devel \
    && dnf clean all
ARG G2G_FEATURES=std,multi-thread,rtsp,rtsp-server,rtsp-client-sink,srt,rist,rtmp,webrtc,webrtc-janus,webrtc-livekit,http-src,hls,dash,ffmpeg,opus,dav1d,observe
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
COPY --from=g2g . /src/glass2glass
RUN cd /src/glass2glass \
    && cargo build --release --locked -p g2g-plugins --bin g2g-launch --features "${G2G_FEATURES}" \
    && cargo build --release --locked --manifest-path examples/g2g-api-soak/Cargo.toml --target-dir target
COPY . /src/calliope
RUN cd /src/calliope && cargo build --release --locked -p calliope-cli

FROM base AS runtime
# ffmpeg, iproute-tc, mediamtx and the gstreamer packages run the faulted feed in g2g-canary-faulted.container
RUN dnf -y install --allowerasing ffmpeg ffmpeg-libs opus libdav1d iproute-tc openssl-libs ca-certificates \
        python3-gobject gstreamer1-rtsp-server gstreamer1-plugins-good gstreamer1-plugins-bad-free \
    && dnf clean all
COPY --from=build /src/glass2glass/target/release/g2g-launch /usr/local/bin/g2g-launch
COPY --from=build /src/glass2glass/target/release/g2g-api-soak /usr/local/bin/g2g-api-soak
COPY --from=build /src/calliope/target/release/calliope /usr/local/bin/calliope
COPY --from=mediamtx /mediamtx /usr/local/bin/mediamtx
COPY --from=mediamtx /clips /usr/share/g2g-canary/clips
COPY --from=livesim2 /livesim2 /usr/local/bin/livesim2
COPY --from=livesim2 /src/cmd/livesim2/app/testdata/assets /usr/share/livesim2/vod
# live555's rtsp proxy, nginx-rtmp, libsrt's srt-live-transmit, janus and livekit run in g2g-canary-peers.container
RUN dnf -y install live555-tools srt nginx-core glib2 jansson libconfig libnice libsrtp libwebsockets && dnf clean all
COPY --from=nginx-rtmp /nginx-src/objs/ngx_rtmp_module.so /usr/lib64/nginx/modules/ngx_rtmp_module.so
COPY --from=janus /opt/janus /opt/janus
COPY --from=livekit /livekit-server /usr/local/bin/livekit-server
COPY --chmod=0755 deploy/canary/peers.sh /usr/local/bin/canary-peers.sh
COPY deploy/canary/nginx-peers.conf deploy/canary/livekit-peers.yaml /etc/canary/
COPY deploy/canary/janus /etc/canary/janus
# nginx refuses a module built for another nginx version, so a mismatch fails the build
RUN nginx -t -c /etc/canary/nginx-peers.conf
COPY --chmod=0755 deploy/canary/faulted.sh /usr/local/bin/canary-faulted.sh
COPY deploy/canary/gst-rtsp-relay.py /usr/local/bin/canary-gst-rtsp-relay.py
COPY deploy/canary/mediamtx-faulted.yml /etc/canary/mediamtx-faulted.yml
COPY deploy/canary/fault-schedule.txt /etc/canary/fault-schedule.txt
# each table decodes a clip through the same chain as the rows that name it
RUN mkdir -p /etc/canary/hashes && cd /usr/share/g2g-canary/clips \
    && g2g-launch -q filesrc location=baseline.mp4 ! qtdemux ! h264parse ! avdec_h264 ! checksumsink \
        > /etc/canary/hashes/baseline.txt \
    && g2g-launch -q filesrc location=hevc.mp4 ! qtdemux ! h265parse ! avdec_h265 ! checksumsink \
        > /etc/canary/hashes/hevc.txt \
    && g2g-launch -q filesrc location=av1.mp4 ! qtdemux ! av1parse ! avdec_av1 ! checksumsink \
        > /etc/canary/hashes/av1.txt \
    && g2g-launch -q filesrc location=vp9.webm ! matroskademux ! avdec_vp9 ! checksumsink \
        > /etc/canary/hashes/vp9.txt
# the egress rows encode losslessly, so their table is the source's frames, one 80 frame loop of the moving bar
RUN g2g-launch -q videotestsrc pattern=moving-bar num-buffers=80 ! video/x-raw,format=I420,width=320,height=240,framerate=30/1 \
        ! checksumsink > /etc/canary/hashes/moving-bar.txt
# the janus and livekit publishers loop the same 80 frames encoded once, one access unit per file
RUN mkdir /usr/share/g2g-canary/clips/moving-bar && cd /usr/share/g2g-canary/clips/moving-bar \
    && g2g-launch -q videotestsrc pattern=moving-bar num-buffers=80 ! video/x-raw,format=I420,width=320,height=240,framerate=30/1 \
        ! x264enc backend=software pass=quant quantizer=0 ! h264parse ! multifilesink location=%02d.h264 \
    && g2g-launch -q multifilesrc location=%02d.h264 framerate=30/1 ! h264parse ! avdec_h264 ! checksumsink \
        | cmp - /etc/canary/hashes/moving-bar.txt
# the switching clip changes size and frame rate mid-stream, the abr row matches whichever variant it reads
RUN cd /usr/share/g2g-canary/clips \
    && g2g-launch -q filesrc location=switching.ts ! tsdemux ! h264parse ! avdec_h264 ! checksumsink \
        > /etc/canary/hashes/switching.txt \
    && g2g-launch -q filesrc location=abr-720.mp4 ! qtdemux ! h264parse ! avdec_h264 ! checksumsink \
        > /etc/canary/hashes/abr-720.txt \
    && g2g-launch -q filesrc location=abr-360.mp4 ! qtdemux ! h264parse ! avdec_h264 ! checksumsink \
        > /etc/canary/hashes/abr-360.txt \
    && g2g-launch -q filesrc location=abr-180.mp4 ! qtdemux ! h264parse ! avdec_h264 ! checksumsink \
        > /etc/canary/hashes/abr-180.txt
COPY deploy/canary/canary.toml /etc/canary/canary.toml
ARG G2G_COMMIT
RUN test -n "${G2G_COMMIT}" || { echo "build with --build-arg G2G_COMMIT=<g2g commit>" >&2; exit 1; }
ENV G2G_COMMIT=${G2G_COMMIT}
WORKDIR /var/lib/canary
ENTRYPOINT ["calliope", "canary", "--config", "/etc/canary/canary.toml"]
