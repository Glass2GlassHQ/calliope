[Unit]
Description=g2g canary: livesim2 serving the self-hosted dash streams

[Container]
Image=ghcr.io/glass2glasshq/g2g-canary:latest
AutoUpdate=registry
ContainerName=g2g-canary-livesim2
Entrypoint=/usr/local/bin/livesim2
Exec=--vodroot /usr/share/livesim2/vod --port 18900
# livesim2 listens on every interface, pasta publishes it on the host loopback only
Network=pasta
PublishPort=127.0.0.1:18900:18900

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
