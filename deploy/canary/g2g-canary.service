[Unit]
Description=g2g canary: g2g pipelines on live streams, uptime and incident log
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=%h/g2g-canary
ExecStartPre=/usr/bin/mkdir -p %h/g2g-canary/data
ExecStart=/usr/bin/podman-compose up
ExecStop=/usr/bin/podman-compose down
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
